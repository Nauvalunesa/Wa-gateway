+		Group:         group.String(),
+		MessageID:     string(messageID),
+		Targets:       targetKeys,
+		TargetMessage: targetTextValue,
+		DecoyMessage:  decoyTextValue,
+	}); err != nil {
+		return_.Error = proto.String(fmt.Sprintf("failed to save SPR retry data: %v", err))
+		return ProtoReturnV3(&return_)
+	}
