+	response, err := client.SendMessage(ctx, group, &message, extra)
+	if err != nil {
+		return_.Error = proto.String(err.Error())
+		return ProtoReturnV3(&return_)
+	}
+	return_.SendResponse = utils.EncodeSendResponse(response)
+	return ProtoReturnV3(&return_)
+}
