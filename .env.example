# Set the hostname that serves the dashboard, including ports for local URLs.
GATEWAY_ALLOWED_HOSTS=utusan.chat,localhost:8880,127.0.0.1:8880,localhost:5173,127.0.0.1:5173,testserver
# Use true behind HTTPS in production; false for local HTTP development.
GATEWAY_SECURE_COOKIE=false
# Optional: provide a stable signing secret through your deployment environment.
# Otherwise, the application creates storage/.session-secret automatically.
